    "ledger_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_entry_id",
        "recorded_at",
        "artifact_id",
        "from_version",
        "to_version",
        "content_origin",
        "ai_suggestion_id",
        "consequence_level",
        "disposition",
        "change_summary",
        "student_critique",
        "student_justification",
        "evidence_locator"
      ],
      "properties": {
        "ledger_entry_id": {
          "$ref": "#/$defs/identifier"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "from_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9999
        },
        "to_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "content_origin": {
          "type": "string",
          "enum": [
            "student_originated",
            "ai_suggested",
            "mixed"
          ]
        },
        "ai_suggestion_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "consequence_level": {
          "type": "string",
          "enum": [
            "inconsequential",
            "consequential"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "accepted_verbatim",
            "modified_or_challenged",
            "rejected",
            "deferred",
            "not_applicable"
          ]
        },
        "change_summary": {
          "$ref": "#/$defs/long_text"
        },
        "student_critique": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4000
        },
        "student_justification": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4000
        },
        "evidence_locator": {
          "$ref": "#/$defs/identifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "content_origin": {
                "enum": [
                  "ai_suggested",
                  "mixed"
                ]
              }
            },
            "required": [
              "content_origin"
            ]
          },
          "then": {
            "properties": {
              "ai_suggestion_id": {
                "$ref": "#/$defs/identifier"
              },
              "disposition": {
                "enum": [
                  "accepted_verbatim",
                  "modified_or_challenged",
                  "rejected",
                  "deferred"
                ]
              },
              "student_critique": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "ai_suggestion_id": {
                "type": "null"
              },
              "disposition": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "consequence_level": {
                "const": "consequential"
              }
            },
            "required": [
              "consequence_level"
            ]
          },
          "then": {
            "properties": {
              "student_justification": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "critique_revision_justification_ledger": {
      "type": "object",
      "additionalProperties": false,
