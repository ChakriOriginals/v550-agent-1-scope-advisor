    "constraints_uncertainties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "items"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/artifact_metadata"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "classification",
              "statement",
              "priority",
              "consequence",
              "verification_needed"
            ],
            "properties": {
              "item_id": {
                "$ref": "#/$defs/identifier"
              },
              "classification": {
                "type": "string",
                "enum": [
                  "constraint",
                  "assumption",
                  "uncertainty",
                  "verification_need"
                ]
              },
              "statement": {
                "$ref": "#/$defs/long_text"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "consequence": {
                "$ref": "#/$defs/long_text"
              },
              "verification_needed": {
                "type": "boolean"
              }
            }
          }
        }
      }
