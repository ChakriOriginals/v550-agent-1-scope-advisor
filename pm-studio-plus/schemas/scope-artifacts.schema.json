        },
        "deliverables": {
          "$ref": "#/$defs/deliverables"
        },
        "scope_of_work": {
          "$ref": "#/$defs/scope_of_work"
        },
        "scope_boundaries": {
          "$ref": "#/$defs/scope_boundaries"
        },
        "scope_action_plan": {
          "$ref": "#/$defs/scope_action_plan"
        },
        "wbs": {
          "$ref": "#/$defs/wbs"
        },
        "assumption_log": {
          "$ref": "#/$defs/assumption_log"
        },
        "constraints_uncertainties": {
          "$ref": "#/$defs/constraints_uncertainties"
        },
        "critique_revision_justification_ledger": {
          "$ref": "#/$defs/critique_revision_justification_ledger"
        }
      }
    }
  }
